<?xml version='1.0' encoding='utf-8'?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="ms_g1_main" android:title="Main Voice">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:key="ms_tts_engine" android:title="Engine" android:dialogTitle="@string/ms_tts_engine_title" android:defaultValue="" android:summary="%s"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:defaultValue="@string/pref_speech_rate_default" android:dialogTitle="@string/ms_tts_speed_title" android:entries="@array/pref_speech_rate_entries" android:entryValues="@array/pref_speech_rate_values" android:key="@string/pref_speech_rate_key" android:summary="%s" android:title="Speed"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:defaultValue="@string/pref_speech_pitch_default" android:dialogTitle="@string/ms_tts_pitch_title" android:entries="@array/ms_tts_pitch_entries" android:entryValues="@array/ms_tts_pitch_values" android:key="@string/pref_speech_pitch_key" android:summary="%s" android:title="Pitch"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:defaultValue="@string/pref_speech_volume_default" android:dialogTitle="@string/ms_tts_volume_title" android:entries="@array/pref_speech_volume_entries" android:entryValues="@array/pref_speech_volume_values" android:key="@string/pref_speech_volume_key" android:summary="%s" android:title="Volume"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:defaultValue="@bool/pref_use_audio_focus_default" android:key="@string/pref_use_audio_focus_key" android:summary="@string/ms_tts_audio_focus_summary" android:title="Use audio focus (audio ducking)"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:defaultValue="@bool/pref_proximity_default" android:key="@string/pref_proximity_key" android:title="Stop speech when proximity sensor is covered"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference android:key="ms_tts_system_settings" android:title="System TTS settings"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="ms_g1_secondary" android:title="Secondary Voice">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:key="ms_async_tts_engine" android:title="Engine" android:dialogTitle="@string/ms_tts_engine_title" android:defaultValue="" android:summary="%s"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:defaultValue="1.0" android:dialogTitle="@string/ms_tts_speed_title" android:entries="@array/pref_speech_rate_entries" android:entryValues="@array/pref_speech_rate_values" android:key="ms_async_tts_speed" android:summary="%s" android:title="Speed"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:defaultValue="1.0" android:dialogTitle="@string/ms_tts_pitch_title" android:entries="@array/ms_tts_pitch_entries" android:entryValues="@array/ms_tts_pitch_values" android:key="ms_async_tts_pitch" android:summary="%s" android:title="Pitch"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:defaultValue="false" android:key="ms_async_tts_accessibility_volume" android:title="Volume mode: follow accessibility volume" android:summary="On: follow the accessibility volume. Off: use the own volume level below" android:disableDependentsState="true"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:defaultValue="100" android:dialogTitle="@string/ms_tts_volume_title" android:entries="@array/ms_tts_percent_entries" android:entryValues="@array/ms_tts_percent_values" android:key="ms_async_tts_volume" android:summary="%s" android:title="Own volume level" android:dependency="ms_async_tts_accessibility_volume"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:defaultValue="false" android:key="ms_async_tts_touch_stop" android:title="Stop on touch"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="ms_g1_voicefor" android:title="Voice For">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:key="ms_notif_use_secondary_tts" android:title="Notifications: use Secondary Voice" android:defaultValue="true"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:key="ms_scn_chat_voice" android:title="Chat messages" android:dialogTitle="@string/ms_scn_chat_voice" android:entries="@array/ms_voice_entries" android:entryValues="@array/ms_voice_values" android:defaultValue="secondary" android:summary="%s"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference android:key="ms_adv_announce_voice" android:title="Date &amp; time" android:dialogTitle="@string/ms_adv_announce_voice" android:entries="@array/ms_voice_entries" android:entryValues="@array/ms_voice_values" android:defaultValue="main" android:summary="%s"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
