<?xml version='1.0' encoding='utf-8'?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="ms_g4_verb" android:title="Verbosity">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference android:key="ms_g4_verb_link" android:title="Verbosity preset and details" android:summary="Preset, element type, usage hints, container info, element IDs, list positions, window names, progress updates, text formatting, pitch changes, punctuation, repeated symbols, capital letters, letters with examples, typing echo" android:fragment="com.google.android.accessibility.talkback.preference.base.VerbosityPrefFragment"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="ms_g4_elements" android:title="Elements and windows">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:key="ms_rd_window_all" android:title="Read whole window on change" android:summary="@string/ms_rd_window_all_sum" android:defaultValue="false"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:key="ms_rd_window_title" android:title="Window names" android:summary="@string/ms_rd_window_title_sum" android:defaultValue="true"/>
