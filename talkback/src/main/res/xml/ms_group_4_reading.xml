    <EditTextPreference android:key="ms_rd_filter_blacklist" android:title="Content blacklist" android:summary="@string/ms_rd_filter_blacklist_sum" android:dialogTitle="@string/ms_rd_filter_blacklist" android:defaultValue=""/>
