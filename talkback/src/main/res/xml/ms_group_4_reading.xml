  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="ms_g4_pron" android:title="Pronunciation">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:key="ms_rd_chars_first" android:title="Read text first when explaining" android:summary="@string/ms_rd_chars_first_sum" android:defaultValue="false"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:key="ms_rd_chars_index" android:title="Latin letter index" android:summary="@string/ms_rd_chars_index_sum" android:defaultValue="false"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="ms_g4_screen" android:title="Screen state">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:key="ms_rd_screen_off" android:title="Say Locked" android:summary="@string/ms_rd_screen_off_sum" android:defaultValue="true"/>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:key="ms_rd_screen_on" android:title="Say Unlocked" android:summary="@string/ms_rd_screen_on_sum" android:defaultValue="true"/>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="ms_g4_dict" android:title="Dictionary &amp; Labels">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference android:key="ms_rd_labels_manage" android:title="Custom label manager" android:summary="@string/ms_rd_labels_manage_sum">
      <intent android:targetPackage="@string/app_id" android:targetClass="com.google.android.accessibility.talkback.labeling.LabelManagerSummaryActivity"/>
    </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference android:key="ms_rd_dict_use" android:title="User dictionary" android:summary="@string/ms_rd_dict_use_sum" android:defaultValue="false"/>
