<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:key="ms_tts_engine"
      android:title="@string/ms_tts_engine_title"
      android:dialogTitle="@string/ms_tts_engine_title"
      android:defaultValue=""
      android:summary="%s" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="ms_tts_system_settings"
      android:title="@string/ms_tts_system_settings_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_speech_rate_default"
      android:dialogTitle="@string/ms_tts_speed_title"
      android:entries="@array/pref_speech_rate_entries"
      android:entryValues="@array/pref_speech_rate_values"
      android:key="@string/pref_speech_rate_key"
      android:summary="%s"
      android:title="@string/ms_tts_speed_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_speech_pitch_default"
      android:dialogTitle="@string/ms_tts_pitch_title"
      android:entries="@array/ms_tts_pitch_entries"
      android:entryValues="@array/ms_tts_pitch_values"
      android:key="@string/pref_speech_pitch_key"
      android:summary="%s"
      android:title="@string/ms_tts_pitch_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_speech_volume_default"
      android:dialogTitle="@string/ms_tts_volume_title"
      android:entries="@array/pref_speech_volume_entries"
      android:entryValues="@array/pref_speech_volume_values"
      android:key="@string/pref_speech_volume_key"
      android:summary="%s"
      android:title="@string/ms_tts_volume_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_use_audio_focus_default"
      android:key="@string/pref_use_audio_focus_key"
      android:summary="@string/ms_tts_audio_focus_summary"
      android:title="@string/ms_tts_audio_focus_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_proximity_default"
      android:key="@string/pref_proximity_key"
      android:title="@string/ms_tts_proximity_title" />
</PreferenceScreen>
